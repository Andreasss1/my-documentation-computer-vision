    if os.path.exists(best_model_path):
        print(f"\n🏆 Best model saved at: {best_model_path}")
        print("   Use this model for inference!")
else:
    print(f"❌ Training results not found")

print("\n✅ Implementation completed!")
print("🔥 Your YOLOv8m model is ready for small defect detection!")

# =============================================
# 10. QUICK INFERENCE TEST (OPTIONAL)
# =============================================

print("\n🧪 Quick Inference Test:")
print("=" * 30)

try:
    # Load the best model
    best_model_path = f"{results_dir}/weights/best.pt"
    if os.path.exists(best_model_path):
        trained_model = YOLO(best_model_path)
